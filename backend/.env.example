# Database
DATABASE_URL=postgresql+asyncpg://travelai:travelai@localhost:5432/travelai

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM — OpenRouter (https://openrouter.ai/keys)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (:free tier — verify ids on OpenRouter before eval)
MODEL_PLANNER=poolside/laguna-xs.2:free
MODEL_VALIDATOR=poolside/laguna-xs.2:free
MODEL_SYNTHESIZER=poolside/laguna-m.1:free

# Optional local fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
USE_OLLAMA_FALLBACK=false

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travelai
LANGSMITH_TRACING=true

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MAX_REPAIR_ROUNDS=2
RAG_TOP_K=5
AGENT_MAX_TOKENS_PLANNER=1024
AGENT_MAX_TOKENS_SPECIALIST=2048
AGENT_MAX_TOKENS_SYNTHESIZER=4096

# Tavily (optional web search — supplementary to RAG)
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=basic
TAVILY_MIN_RAG_CHUNKS=2

# Paths (Docker compose sets /datasets; local dev can leave unset)
